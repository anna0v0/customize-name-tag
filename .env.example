NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shopify Headless storefront
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token
SHOPIFY_CLIENT_ID=your-dev-dashboard-client-id
SHOPIFY_CLIENT_SECRET=your-dev-dashboard-client-secret
# Optional override. By default webhook HMAC uses SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_NAME_TAG_PRODUCT_ID=gid://shopify/Product/0000000000000
SHOPIFY_NAME_TAG_VARIANT_ID=gid://shopify/ProductVariant/0000000000000
SHOPIFY_ORGANIZER_PRODUCT_ID=gid://shopify/Product/0000000000000
SHOPIFY_ORGANIZER_VARIANT_ID=gid://shopify/ProductVariant/0000000000000
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=https://shopify.com/00000000000/account
CRON_SECRET=use-a-long-random-value
